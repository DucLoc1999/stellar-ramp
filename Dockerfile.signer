# Local-only image for the Stellar signer (Cloudflare Worker via `wrangler dev`).
# Uses Debian-based node (not alpine) because workerd requires glibc.
FROM node:24-slim AS base
WORKDIR /app

# Install deps (incl. wrangler devDependency) — do NOT set NODE_ENV=production here.
COPY stellar_signer_worker/package.json stellar_signer_worker/package-lock.json ./
RUN npm ci

# Worker source + config (wrangler.toml points main → src/index.ts)
COPY stellar_signer_worker/ ./

EXPOSE 8787

# --ip 0.0.0.0 so other compose services can reach it; local mode is the v4 default.
CMD ["npx", "wrangler", "dev", "--ip", "0.0.0.0", "--port", "8787"]
